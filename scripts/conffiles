#!/bin/bash -e

# Copy the config files to the system.

THIS_SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
source "${THIS_SCRIPT_DIR}/common"

installConfigFiles() {
    message $'Installing configuration files.'

    # Copy files over from the directory containing the
    # configuration files to /.
    superUserDo cp -ruv "${CONFIG_DIR}/etc/"* /etc

    # 'cp -u' skips files that were modified after the ones in this repo, so
    # overwrite these explicitly in order to pick up updates on re-runs.
    while read -r file; do
        # Unfortunately 'realpath --relative-to' is not POSIX and therefore not
        # available on MacOS by default, so we assume a single level by using
        # 'basename'.
        local fileRelative="$(basename "${file}")"
        local fileDestination="/etc/anthonyzation.d/${fileRelative}"
        superUserDo mkdir -p "$(dirname "${fileDestination}")"
        superUserDo cp "${file}" "${fileDestination}" || return
    done < <(find "${CONFIG_DIR}/etc/anthonyzation.d" -type f)
}
